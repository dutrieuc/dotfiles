[user]
	email = cydu@odoo.com
	name = Cyril Dutrieux (cydu)
[core]
	editor = kak
	pager = delta
[alias]
	g = grep --break --heading --line-number
    lg = log --graph --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %ar)%Creset'
    hist = log --graph --date=short --pretty=tformat:'%Cred%h%Creset %Cgreen%ad%Creset | %C(auto)%d%Creset %s %Cgreen(%an)%Creset' --all
	fpush = push --force-with-lease
	slog = log --pretty=format:'%s' --abbrev-commit
	release-log = log --pretty=format:'%s'
[pull]
	rebase = true
[rerere]
	enabled = false
[safe]
	directory = /opt/flutter
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[submodule]
	recurse = true
[pack]
	threads = 3
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
