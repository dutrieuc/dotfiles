#!/bin/sh
cd ~/local/toggl_to_odoo/
. ./venv/bin/activate
echo "Uploading T.S."
datetime=$(date -d "now - 14 days" +%Y-%m-%d)
echo "On odoo.com"
python3 -m toggl_to_odoo upload -vv -ds "$datetime" --force -te freelance --merge -u cydu@odoo.com -p $(secret-tool lookup odoo.com apikey) toggl2odoo https://www.odoo.com openerp history.log
# echo "On project-tool"
# python3 -m toggl_to_odoo upload -ds "$datetime" --force -ti project-tool --merge -u cydu@odoo.com -p $(secret-tool lookup project-tool.odoo.com apikey) toggl2odoo https://project-tool.odoo.com  odoo-ps-psbe-large-project-tool-14-0-master-1964163 history-project-tool
echo "Done uploading"
exit 0
